{
  "name": "react-native-material-design",
  "version": "1.0.0-alpha.01",
  "description": "Cross platform Material Design for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./init": {
      "source": "./src/init.ts",
      "types": "./lib/typescript/src/init.d.ts",
      "default": "./lib/module/init.js"
    },
    "./ui/*": {
      "source": "./src/components/ui/*.tsx",
      "types": "./lib/typescript/src/components/ui/*.d.ts",
      "default": "./lib/module/components/ui/*.js"
    },
    "./navigation/*": {
      "source": "./src/navigation/*.tsx",
      "types": "./lib/typescript/src/navigation/*.d.ts",
      "default": "./lib/module/navigation/*.js"
    },
    "./navigation/expo/*": {
      "source": "./src/navigation/expo/*.tsx",
      "types": "./lib/typescript/src/navigation/expo/*.d.ts",
      "default": "./lib/module/navigation/expo/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "watch": "nodemon --watch src --ext ts,tsx --exec 'bun run build'",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "package": "npm pack",
    "example": "bun run build && bun run --cwd example start",
    "example:ios": "bun run build && bun run --cwd example ios",
    "example:android": "bun run build && bun run --cwd example android",
    "example:web": "bun run build && bun run --cwd example web",
    "extract:pages": "bun run --cwd=material extract:pages",
    "extract:sitemap": "bun run --cwd=material extract:sitemap",
    "validate:docs": "bun run --cwd=material validate:docs",
    "query:docs": "bun run --cwd=material query:docs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "material-design"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anastasesg/react-native-material-design.git"
  },
  "author": "Anastases Giannikopoulos <anastasesgiannikopoulos@gmail.com> (https://github.com/anastasesg)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anastasesg/react-native-material-design/issues"
  },
  "homepage": "https://github.com/anastasesg/react-native-material-design#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "expo-router": "^4.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/eslint-plugin": "^0.82.1",
    "@types/bun": "^1.3.8",
    "@types/flubber": "^0.4.0",
    "@types/react": "^19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.16",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-nitro-modules": "0.31.10",
    "react-native-reanimated": "^4.1.5",
    "react-native-svg": "^15.15.3",
    "react-native-unistyles": "3.0.18",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7",
    "react": "*",
    "react-native": ">=0.78",
    "react-native-gesture-handler": ">=2.20",
    "react-native-nitro-modules": "~0.31.10",
    "react-native-reanimated": ">=4",
    "react-native-svg": ">=13",
    "react-native-unistyles": "~3.0.18",
    "typescript": ">5.0",
    "expo-router": "^4"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "tools": [
      "eslint"
    ],
    "version": "0.55.1"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "flubber": "^0.4.2"
  }
}
